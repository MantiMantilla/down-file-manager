{
  "sourceLanguage" : "en",
  "strings" : {
    "%@\n\nmacOS may need you to allow Down to access this location." : {
      "comment" : "Shown under Access Denied; the argument is the error message"
    },
    "%@ %@" : {
      "comment" : "Modified column, this week: the weekday name, then the time",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ %2$@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "Transfer failure alert, one line per item: the file name, then the error message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@"
          }
        }
      }
    },
